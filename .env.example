# CoalIntel Environment Variables Template
# Copy this file to .env and configure your keys

# AI Provider Selection: 'gemini' (default, cloud) or 'ollama' (local fallback)
AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Local Ollama Configuration (Fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# MongoDB Configuration
# For MongoDB Atlas (Cloud Cluster):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
# For Local MongoDB (Development Fallback):
# MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=coalintel
DATABASE_MODE=atlas
# Options for DATABASE_MODE: 'atlas' (strictly cloud, fails if offline), 'local', or 'auto'

# Security & RBAC Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Administrative Bootstrap Credentials (Used only on initial empty DB)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@coalintel.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@CoalIntel2026!
